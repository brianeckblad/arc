{
  "_README": "Builtin command registry — visibility, display names, and help text for all shell builtins. Loaded by app/settings/commands.py. Values for 'visible': true (shown + executable), \"dev\" (dev mode only — hidden + blocked for normal users), \"hidden\" (executable always, not shown in ? — dev mode reveals it), false (hidden + blocked for everyone). 'configure_only': shown only in configure mode. 'hide_in_configure': hidden in configure mode. 'display': the name shown in ? help. 'help': the description shown in ? help. Entries without 'help' appear in SHELL_BUILTINS for dispatch/completion but not in ? help rows.",
  "?": {
    "visible": "hidden",
    "display": "?",
    "help": "",
    "configure_only": false,
    "hide_in_configure": false,
    "onlogin": false,
    "startup_hint": "Context-Aware Help  [dim](or  help <topic>)[/dim]"
  },
