#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# ARC pre-commit hook
#
# 1. Auto-bump version on every commit.
# 2. Run smoke_test.py — blocks the commit if any check fails.
#
# Format: 0.1.<N>  where N = total commit count after this commit lands.
#
# Files updated by version bump:
#   app/__init__.py  — runtime __version__ (read by the shell at startup)
#   pyproject.toml   — package version (kept in sync for pip/uv installs)
#
# Install once per clone:
#   git config core.hooksPath .githooks
# ---------------------------------------------------------------------------
set -e

# ---------------------------------------------------------------------------
# Step 0 — regenerate the code map so dev/CODE_MAP.md never drifts.
#   This keeps the line-range navigation file (read by AI agents) accurate.
# ---------------------------------------------------------------------------
echo "[arc] refreshing dev/CODE_MAP.md…"
python3 dev/gen_code_map.py >/dev/null 2>&1 || true
git add dev/CODE_MAP.md 2>/dev/null || true

# ---------------------------------------------------------------------------
# Step 0.5 — offline self-test of the docs engine (no network).
#   Validates path-discovery + endpoint-diff logic in update_scm_docs.py.
# ---------------------------------------------------------------------------
echo "[arc] docs engine self-test…"
if ! python3 dev/update_scm_docs.py --self-test >/dev/null 2>&1; then
    echo "[arc] ✗ docs engine self-test failed — commit blocked"
    exit 1
fi

# ---------------------------------------------------------------------------
# Step 1 — smoke tests (alignment + imports + registry + types + formatter)
# ---------------------------------------------------------------------------
echo "[arc] running smoke tests…"
if ! python3 dev/smoke_test.py --quiet; then
    echo "[arc] ✗ smoke tests failed — commit blocked"
    exit 1
fi
echo "[arc] ✓ smoke tests passed"

# ---------------------------------------------------------------------------
# Step 2 — version bump
# ---------------------------------------------------------------------------
COUNT=$(git rev-list --count HEAD 2>/dev/null || echo 0)
NEXT=$((COUNT + 1))
VERSION="0.1.${NEXT}"

# Update app/__init__.py
python3 - "$VERSION" << 'PYEOF'
import re, sys
path = "app/__init__.py"
txt  = open(path).read()
new  = re.sub(r'__version__\s*=\s*"[^"]+"', f'__version__ = "{sys.argv[1]}"', txt)
open(path, "w").write(new)
PYEOF

# Update pyproject.toml (first version = line only, not dependency specs)
python3 - "$VERSION" << 'PYEOF'
import re, sys
path = "pyproject.toml"
txt  = open(path).read()
# Match 'version = "..."' as a standalone line (not inside a dependency string)
new  = re.sub(r'^version\s*=\s*"[^"]+"', f'version = "{sys.argv[1]}"', txt, count=1, flags=re.MULTILINE)
open(path, "w").write(new)
PYEOF

git add app/__init__.py pyproject.toml
echo "[arc] version bumped to ${VERSION}"

