# Secrets and credentials
.env
.env.*
*.secret

# arc runtime data
~/.arc/

# Per-user config directories (config/<username>/) — contain non-sensitive local
# settings; not committed so each developer keeps their own values locally.
# config/config.example.json is intentionally tracked as a template.
config/*/

# Docs — generated by `arc cliup` (run once after clone to build locally)
docs/vendor/
docs/docs-bundle.js

# Session memory (local only)
SESSION.md

# Local git hooks — set up from docs/dev-versioning.md, never committed
.githooks/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Ruff / linting
.ruff_cache/

# IDE
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store

#Idea files
ideas/
